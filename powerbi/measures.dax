-- Assumes the imported table is named 'claims_processed'. Format money measures as currency in Power BI.
Total Claims =
COUNTROWS(claims_processed)

Denied Claims =
CALCULATE([Total Claims], claims_processed[denied_flag] = TRUE())

Denial Rate % =
DIVIDE([Denied Claims], [Total Claims], 0)

Total Billed =
SUM(claims_processed[billed_amount])

Total Paid =
SUM(claims_processed[paid_amount])

Denied Exposure =
SUM(claims_processed[denied_amount])

Appeal Recovered =
SUM(claims_processed[appeal_recovered_amount])

Net Unrecovered =
SUM(claims_processed[net_unrecovered_amount])

Appeals Submitted =
CALCULATE([Total Claims], claims_processed[appeal_submitted] = TRUE())

Appeals Won =
CALCULATE([Total Claims], claims_processed[appeal_won] = TRUE())

Appeal Success Rate % =
DIVIDE([Appeals Won], [Appeals Submitted], 0)

Appeal Submission Rate % =
DIVIDE(
    CALCULATE([Total Claims], claims_processed[appeal_submitted] = TRUE()),
    [Denied Claims],
    0
)

Average Denied Amount =
DIVIDE([Denied Exposure], [Denied Claims], 0)

Recovery Rate % =
DIVIDE([Appeal Recovered], [Denied Exposure], 0)

-- Optional weighted rate: useful when comparing groups with different claim volumes.
Denied Claim Count Label =
FORMAT([Denied Claims], "#,##0")
